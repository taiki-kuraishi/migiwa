{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "migiwa-remote-mcp",
  "main": "./src/entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cross-script binding: BotObject is defined and migrated by migiwa-bot (spec D5), so a
  // deploy of this Worker never restarts the Durable Object and its gateway socket.
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "BotObject", "script_name": "migiwa-bot" }],
  },
  // Bearer token for POST /mcp (wave 7, spec §7.1). Required: a deploy without it set fails,
  // so set it with `wrangler secret put API_TOKEN` before the next deploy.
  "secrets": { "required": ["API_TOKEN"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
}
