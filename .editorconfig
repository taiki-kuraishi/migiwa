# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
trim_trailing_whitespace = false

# drizzle-kit's own generated output (see AGENTS.md "Generated code"); saving one of these
# files here would rewrite drizzle's formatting and trip drizzle-ci.yml's drift check for
# reasons that have nothing to do with drift.
[packages/db/drizzle/**]
trim_trailing_whitespace = false
insert_final_newline = false

# migrations.d.ts is the one hand-written file in that tree (see .gitattributes) and follows
# the normal rules.
[packages/db/drizzle/migrations.d.ts]
trim_trailing_whitespace = true
insert_final_newline = true

# wrangler's generated output (see AGENTS.md "Generated code"): tab-indented with trailing
# whitespace on several lines. Unlike the drizzle case above, CI does not catch a corruption
# here: cf-typegen --check only compares the header hash, and the lefthook cf-typegen job
# regenerates over whatever an editor leaves behind.
[apps/*/worker-configuration.d.ts]
indent_style = tab
trim_trailing_whitespace = false
